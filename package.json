{
  "name": "vscode-regexplus",
  "displayName": "Regex+",
  "description": "Highlighting for Regex+ template strings",
  "version": "0.0.1",
  "icon": "./docs/regex+.png",
  "galleryBanner": {
    "color": "#fcfcfc",
    "theme": "light"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.115.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "regex+",
    "javascript",
    "typescript",
    "regular",
    "expression"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "contributes": {
    "languages": [
      {
        "id": "regex+",
        "extensions": [
          ".regex+"
        ],
        "configuration": "./languages/regex+.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "regex+",
        "scopeName": "text.regexplus",
        "path": "./languages/grammars/regex+.tmLanguage.json"
      },
      {
        "injectTo": [
          "source.ts"
        ],
        "scopeName": "text.embedded.ts.regexplus",
        "path": "./languages/grammars/injection.ts.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.template.regexplus": "regex+"
        }
      },
      {
        "injectTo": [
          "source.tsx"
        ],
        "scopeName": "text.embedded.tsx.regexplus",
        "path": "./languages/grammars/injection.tsx.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.template.regexplus": "regex+"
        }
      },
      {
        "injectTo": [
          "source.js"
        ],
        "scopeName": "text.embedded.js.regexplus",
        "path": "./languages/grammars/injection.js.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.template.regexplus": "regex+"
        }
      },
      {
        "injectTo": [
          "source.jsx"
        ],
        "scopeName": "text.embedded.jsx.regexplus",
        "path": "./languages/grammars/injection.jsx.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.template.regexplus": "regex+"
        }
      }
    ]
  },
  "repository": {
    "url": "https://github.com/Septh/vscode-regex.git"
  },
  "bugs": {
    "url": "https://github.com/Septh/vscode-regex/issues"
  },
  "type": "commonjs",
  "main": "./out/index.js",
  "files": [
    "./out",
    "./languages",
    "!*.map"
  ],
  "scripts": {
    "clean": "rimraf out dist languages/grammars",
    "prebuild": "npm run clean",
    "build": "npm run buildOnly",
    "buildOnly": "npm run build:js && npm run build:grammars",
    "build:js": "tsc -p tsconfig.build.json",
    "build:grammars": "node script/convert-grammars.mts",
    "watch:grammars": "node script/convert-grammars.mts --watch",
    "pretest": "npm run build",
    "test": "npm run testOnly",
    "testOnly": "echo \"Error: no test specified\" && exit 1",
    "prepublishOnly": "npm run buildOnly"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.12.2",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.9.0",
    "js-yaml": "^4.1.1",
    "regex": "^6.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2"
  }
}
