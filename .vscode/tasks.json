{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "clean",
      "type": "npm",
      "script": "clean",
      "presentation": {
        "group": "X"
      }
    },
    {
      "label": "build:code",
      "type": "typescript",
      "tsconfig": "tsconfig.build.json",
      "option": "watch",
      "problemMatcher": "$tsc-watch",
      // "dependsOn": "clean",
      // "dependsOrder": "sequence",
      "presentation": {
        "group": "X"
      }
    },
    {
      "label": "build:grammars",
      "type": "shell",
      "command": "node",
      "args": [ "${workspaceFolder}/script/convert-grammarS.mts", "--watch" ],
      // "dependsOn": "clean",
      // "dependsOrder": "sequence",
      "isBackground": true,
      "presentation": {
        "group": "X"
      }
    },
    {
      "label": "build:all",
      "hide": true,
      "dependsOn": [ "build:code", "build:grammars" ],
      "dependsOrder": "parallel"
    },
    {
      "label": "build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": "build:all",
      "dependsOrder": "sequence"
    }
  ]
}
