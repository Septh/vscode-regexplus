{
  "js/ts.tsdk.path": "node_modules\\typescript\\lib",
  "debug.openDebug": "neverOpen",
  "yaml.schemas": {
    "https://www.schemastore.org/tmlanguage.json": "source/grammars/*.tm.yaml"
  },
  "files.associations": {
    "/source/grammars/*.yaml": "yaml"
  },
  "[json-textmate]": {
    "editor.bracketPairColorization.enabled": false
  },
  "cSpell.enabledFileTypes": {
    "yaml": true,
    "json": true
  },
  "cSpell.words": [
    "Levithan's",
    "lezer",
    "regexplus",
    "slevithan",
    "tsls",
    "xdigit"
  ]
}
